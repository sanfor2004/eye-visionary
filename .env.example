DATABASE_URL=postgresql+psycopg://postgres:replace-me@127.0.0.1:5432/eye_visionary
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_ROOT=data/images
MODEL_CACHE_ROOT=data/models
EYE_VISIONARY_OFFLINE=false
ANALYSIS_VERSION=1
FACE_VECTOR_DIMENSION=512
MAX_IMAGE_BYTES=25000000
WORKER_CONCURRENCY=1
MAX_JOB_RETRIES=3
GPS_POLICY=retain
RETENTION_DAYS=

# Format: key=scope1,scope2;another-key=scope1
# Keep real values only in .env or the process environment.
EYE_VISIONARY_API_KEYS=local-dev-key=images:read,images:write,faces:read,faces:search,gps:read,exif:read,embeddings:read,images:delete
EYE_VISIONARY_ALLOW_ANONYMOUS=false
